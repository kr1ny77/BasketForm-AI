@startuml component-diagram
skinparam componentStyle rectangle
skinparam backgroundColor white

title BasketForm-AI — Static Component View

actor "User\n(Browser)" as User

package "Frontend" {
    [Upload Page] as Upload
    [Results Page] as Results
    [Profile Page] as Profile
    [Friends Page] as Friends
    [Shared Page] as Shared
}

package "Go Server (port 8080)" {
    [Auth Middleware] as Auth
    [Handlers\n(api, auth, friends, share)] as Handlers
    [Services\n(storage, auth, processor)] as Services
    [Models] as Models
}

package "ML Pipeline" {
    [main.py] as MLMain
    [ball_tracker.py\n(YOLO)] as BallTrack
    [pose_tracker.py\n(MediaPipe)] as PoseTrack
    [shot_analyzer.py\n(State Machine)] as ShotAnalyze
    [feedback_generator.py\n(OpenRouter LLM)] as Feedback
}

package "External Services" {
    database "JSON Files\n(data/)" as JSONFiles
    database "Uploads\n(uploads/)" as Uploads
    database "Results\n(results/)" as ResultsDir
    cloud "OpenRouter API\n(GPT-4o-mini)" as LLM
}

' Frontend connections
User --> Upload : HTTP POST\n(upload video)
User --> Results : HTTP GET\n(view results)
User --> Profile : HTTP GET/POST\n(manage account)
User --> Friends : HTTP GET/POST\n(manage friends)
User --> Shared : HTTP GET\n(view shared)

Upload --> Auth : cookie token
Results --> Auth : cookie token
Profile --> Auth : cookie token
Friends --> Auth : cookie token
Shared --> Auth : cookie token

' Auth to handlers
Auth --> Handlers : authenticated\nrequest

' Handlers to services
Handlers --> Services : business logic

' Services to data
Services --> JSONFiles : read/write\nuser/video data
Services --> Uploads : save uploaded\nvideo files
Services --> ResultsDir : save/load\nresult JSON

' ML integration
Services --> MLMain : exec.Command\n(process video)
MLMain --> BallTrack : detect ball
MLMain --> PoseTrack : detect pose
MLMain --> ShotAnalyze : analyze phases
MLMain --> Feedback : score + feedback
BallTrack --> Uploads : read video
PoseTrack --> Uploads : read video
Feedback --> LLM : HTTP API\n(frames + metrics)

@enduml
